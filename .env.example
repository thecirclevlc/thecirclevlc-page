# The Circle — variables de entorno
# Copiar a .env.local para desarrollo. Los valores reales están en Vercel.
# NUNCA commitear valores reales: la RECAPTCHA_SECRET_KEY ya se filtró una vez
# en los .md del repo (commit 485c28f) y hubo que rotarla.

# ── Cliente (van al bundle — son públicas por diseño) ─────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key del dashboard de Supabase>
VITE_RECAPTCHA_SITE_KEY=<site key de Google reCAPTCHA v2>

# ── Servidor (solo funciones de api/ — NUNCA con prefijo VITE_) ───
RECAPTCHA_SECRET_KEY=<secret key de Google reCAPTCHA v2>
ALLOWED_ORIGIN=https://www.thecirclevlc.com

# api/index.ts acepta SUPABASE_URL/SUPABASE_ANON_KEY y cae a las VITE_ si faltan.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
